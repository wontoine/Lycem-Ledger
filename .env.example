# Copy this file to .env and fill in the values.
# Do NOT commit your real .env with secrets to version control.

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True

# MongoDB (adjust as needed)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=group3f25_db
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_URI=

# Email via Gmail (uses Google SMTP — no separate SMTP server required)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Your Gmail address
EMAIL_HOST_USER=your_account@gmail.com
# Use a Google App Password generated under your Google Account > Security
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=your_account@gmail.com

# Optional: if you have a frontend to handle the reset form, set its URL here
# The token will be appended to this base (if it doesn't end with =, a ?token= will be used)
# Example: https://your-frontend/reset-password?token=
PASSWORD_RESET_BASE_URL=

# Company email domain (used only for classifying account type in responses)
COMPANY_EMAIL_DOMAIN=lyceum-ledgers.com
